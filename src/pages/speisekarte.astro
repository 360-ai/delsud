---
import { useStoryblokApi } from '@storyblok/astro';

let cms: any = {
  phone_display: '0170 3678734',
  phone_link: '01703678734',
  email: 'info@delsud-frankenberg.de',
  instagram_url: 'https://www.instagram.com/del_sud_italiano_/',
  speisekarte_pdf: null, // Storyblok Asset-Feld (optional)
};

try {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get('cdn/stories/home', {
    version: 'published',
  });
  cms = { ...cms, ...data.story.content };
} catch (e) {}

const pdfUrl = cms.speisekarte_pdf?.filename || '/downloads/Del-Sud-Speisekarte.pdf';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Speisekarte – Del Sud | Italienisches Restaurant &amp; Pizzeria Frankenberg (Eder)</title>
  <meta name="description" content="Speisekarte des Del Sud in Frankenberg (Eder): Pizza, Pasta, italienische Küche &amp; mehr. PDF zum Ansehen und Download — Bar, Ristorante, Pizzeria." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://delsud-frankenberg.de/speisekarte/" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:title" content="Speisekarte – Del Sud Frankenberg" />
  <meta property="og:description" content="Unsere aktuelle Speisekarte als PDF: Pizza, Pasta und italienische Spezialitäten in Frankenberg (Eder)." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://delsud-frankenberg.de/speisekarte/" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Del Sud Frankenberg" />
  <meta property="og:image" content="https://delsud-frankenberg.de/images/og-image.jpg?v=2" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Del Sud – Restaurant in Frankenberg (Eder)" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Speisekarte – Del Sud Frankenberg" />
  <meta name="twitter:description" content="Aktuelle Speisekarte als PDF – italienische Küche in Frankenberg." />
  <meta name="twitter:image" content="https://delsud-frankenberg.de/images/og-image.jpg?v=2" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Speisekarte – Del Sud",
    "description": "Speisekarte des italienischen Restaurants Del Sud in Frankenberg (Eder).",
    "url": "https://delsud-frankenberg.de/speisekarte/",
    "isPartOf": { "@type": "WebSite", "name": "Del Sud Frankenberg", "url": "https://delsud-frankenberg.de/" }
  })}></script>

  <style>
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/cormorant-garamond-600.woff2') format('woff2');}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/cormorant-garamond-700.woff2') format('woff2');}
    @font-face{font-family:'Mulish';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/mulish-400.woff2') format('woff2');}
    @font-face{font-family:'Mulish';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/mulish-700.woff2') format('woff2');}
    :root {
      --burg: #3D1010;
      --gold: #C9963A;
      --gold-lt: #E8BF7A;
      --gold-border: rgba(201,150,58,0.30);
      --cream: #FAF6EE;
      --text: #1A0F0A;
      --muted: #6B5040;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Mulish', 'Trebuchet MS', sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:var(--font-sans);background:var(--cream);color:var(--text);line-height:1.65;}
    a{color:inherit;}
    .skip-link{position:absolute;top:-999px;left:-999px;z-index:10000;padding:10px 18px;background:var(--gold);color:var(--burg);font-weight:700;text-decoration:none;border-radius:4px;}
    .skip-link:focus{top:12px;left:12px;}

    .topbar{background:var(--burg);color:#fff;padding:16px 0;border-bottom:1px solid var(--gold-border);}
    .topbar-inner{max-width:1140px;margin:0 auto;padding:0 36px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;}
    .topbar .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#fff;}
    .topbar .brand img{width:36px;height:36px;border-radius:50%;object-fit:cover;border:1.5px solid var(--gold);}
    .topbar .brand span{font-family:var(--font-serif);font-weight:700;font-size:1.2rem;letter-spacing:0.08em;}
    .topbar .brand:hover span{color:var(--gold-lt);}
    .topbar-nav{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;}
    .topbar-nav a{color:rgba(255,255,255,0.82);font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;}
    .topbar-nav a:hover{color:var(--gold-lt);}
    .topbar-nav a[aria-current="page"]{color:var(--gold-lt);border-bottom:2px solid var(--gold);padding-bottom:2px;}
    .hamburger-sub{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none;}
    .hamburger-sub span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:0.35s ease;}
    .mobile-sub-menu{display:none;position:fixed;top:53px;left:0;right:0;bottom:0;background:rgba(14,5,5,0.97);backdrop-filter:blur(18px);padding:32px 24px;flex-direction:column;gap:0;z-index:999;border-top:2px solid var(--gold);overflow-y:auto;}
    .mobile-sub-menu.open{display:flex;}
    .mobile-sub-menu a{font-size:0.85rem;font-weight:700;color:rgba(255,255,255,0.65);letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;padding:16px 0;border-bottom:1px solid rgba(201,150,58,0.12);transition:color 0.35s ease,padding-left 0.35s ease;}
    .mobile-sub-menu a:hover,.mobile-sub-menu a:active{color:var(--gold-lt);padding-left:8px;}
    .mobile-sub-menu a[aria-current="page"]{color:var(--gold-lt);}

    .wrap{max-width:900px;margin:0 auto;padding:40px 24px 72px;}
    .eyebrow{font-size:0.68rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;}
    h1{font-family:var(--font-serif);font-size:clamp(2rem,4vw,2.75rem);font-weight:700;color:var(--burg);line-height:1.12;margin-bottom:12px;}
    .lead{color:var(--muted);font-size:1rem;margin-bottom:28px;max-width:52ch;}
    .gold-line{width:54px;height:2px;background:var(--gold);margin-bottom:28px;}

    .actions{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:36px;}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 26px;border-radius:50px;font-weight:700;font-size:0.78rem;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;transition:0.35s ease;border:none;cursor:pointer;font-family:var(--font-sans);}
    .btn-gold{background:var(--gold);color:#fff;}
    .btn-gold:hover{background:var(--burg);transform:translateY(-2px);box-shadow:0 10px 28px rgba(201,150,58,0.35);}
    .btn-ghost{background:transparent;color:var(--burg);border:1.5px solid var(--gold);}
    .btn-ghost:hover{background:rgba(61,16,16,0.06);}

    .highlights{background:rgba(61,16,16,0.04);border:1px solid var(--gold-border);border-radius:14px;padding:26px 28px;margin-bottom:36px;}
    .highlights h2{font-family:var(--font-serif);font-size:1.35rem;color:var(--burg);margin-bottom:14px;}
    .highlights p{font-size:0.92rem;color:var(--muted);margin-bottom:16px;}
    .highlights ul{list-style:none;}
    .highlights li{padding:10px 0;border-bottom:1px solid rgba(201,150,58,0.2);font-size:0.95rem;}
    .highlights li:last-child{border-bottom:none;}
    .highlights strong{color:var(--burg);font-weight:700;}
    ul.menu-toc{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;}
    @media(max-width:640px){ul.menu-toc{grid-template-columns:1fr;}}

    .pdf-box{border:1px solid var(--gold-border);border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,0.06);}
    .pdf-box h2{font-family:var(--font-serif);font-size:1.1rem;color:var(--burg);padding:16px 20px;background:rgba(61,16,16,0.06);border-bottom:1px solid var(--gold-border);}
    .pdf-frame-wrap{min-height:400px;background:#f5f0e8;position:relative;}
    .pdf-frame-wrap iframe{display:block;}
    .pdf-mobile-fallback{display:none;padding:48px 24px;text-align:center;}
    .pdf-mobile-fallback p{color:var(--muted);font-size:0.95rem;margin-bottom:20px;}

    footer{margin-top:48px;padding:28px 24px;background:#0E0505;text-align:center;}
    .foot-copy{font-size:0.72rem;color:rgba(255,255,255,0.22);}
    .foot-copy a{color:var(--gold);opacity:0.7;text-decoration:none;}
    .foot-links{display:flex;gap:18px;flex-wrap:wrap;justify-content:center;margin-bottom:14px;}
    .foot-links a{font-size:0.75rem;color:rgba(255,255,255,0.38);text-decoration:none;}
    .foot-links a:hover{color:var(--gold-lt);}

    @media(max-width:768px){
      .actions{display:none;}
      .lead{margin-bottom:16px;}
    }
    @media(max-width:680px){
      .topbar-inner{padding:0 20px;}
      .topbar-nav{display:none;}
      .hamburger-sub{display:flex;}
    }
  </style>
  <script
    is:inline
    defer
    src="https://stats.360-ai.org/script.js"
    data-website-id="410e2190-47ef-447c-a6a9-36671bdae032"
    data-domains="delsud-frankenberg.de,www.delsud-frankenberg.de"
    data-do-not-track="true"
    data-exclude-search="true"
    data-exclude-hash="true"
  ></script>
</head>
<body>
  <a href="#inhalt" class="skip-link">Zum Inhalt springen</a>

  <header class="topbar">
    <div class="topbar-inner">
    <a class="brand" href="/">
      <img src="/images/site-embed-01.webp" alt="" width="36" height="36" />
      <span>DEL SUD</span>
    </a>
    <nav class="topbar-nav" aria-label="Hauptnavigation">
      <a href="/">Start</a>
      <a href="/#about">Über uns</a>
      <a href="/#offer">Angebot</a>
      <a href="/#hours">Öffnungszeiten</a>
      <a href="/speisekarte/" aria-current="page">Speisekarte</a>
      <a href="/#contact">Kontakt</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </nav>
    <button class="hamburger-sub" id="ham-sub" aria-label="Navigation öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    </div>
  </header>
  <div class="mobile-sub-menu" id="mob-sub">
    <a href="/">Start</a>
    <a href="/speisekarte/" aria-current="page">Speisekarte</a>
    <a href="/#hours">Öffnungszeiten</a>
    <a href="/#contact">Kontakt</a>
    <a href="/impressum/">Impressum</a>
    <a href="/datenschutz/">Datenschutz</a>
  </div>

  <main id="inhalt" class="wrap">
    <p class="eyebrow">Bar · Ristorante · Pizzeria</p>
    <h1>Speisekarte</h1>
    <div class="gold-line"></div>
    <p class="lead">
      Entdecken Sie unsere Auswahl an Pizza, Pasta, Fleisch- und Fischgerichten, Desserts und italienischen Weinen. Die vollständige Karte können Sie hier direkt ansehen oder als PDF herunterladen.
    </p>

    <div class="actions">
      <a class="btn btn-gold" href={pdfUrl} target="_blank" rel="noopener">PDF im neuen Tab</a>
      <a class="btn btn-ghost" href={pdfUrl} download="Del-Sud-Speisekarte.pdf">Herunterladen</a>
    </div>

    <section class="pdf-box" aria-label="Speisekarte PDF">
      <div class="pdf-frame-wrap">
        <iframe id="pdf-iframe" src={pdfUrl} title="Speisekarte Del Sud" style="width:100%;height:80vh;min-height:600px;border:none;"></iframe>
        <div class="pdf-mobile-fallback" id="pdf-mobile-fallback">
          <p>Die Speisekarte lässt sich auf diesem Gerät nicht direkt anzeigen.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
            <a class="btn btn-gold" href={pdfUrl} target="_blank" rel="noopener">Speisekarte öffnen</a>
            <a class="btn btn-ghost" href={pdfUrl} download="Del-Sud-Speisekarte.pdf">Herunterladen</a>
          </div>
        </div>
      </div>
    </section>

    <section class="highlights" aria-label="Küche im Überblick">
      <h2>Auf einen Blick</h2>
      <p>So ist unsere Speisekarte gegliedert — alle Gerichte und Preise stehen in der PDF im Detail.</p>
      <ul class="menu-toc">
        <li><strong>Suppen</strong></li>
        <li><strong>Vorspeisen</strong></li>
        <li><strong>Salate</strong></li>
        <li><strong>Nudeln</strong></li>
        <li><strong>Fleisch</strong></li>
        <li><strong>Fisch</strong></li>
        <li><strong>Pizza</strong></li>
        <li><strong>Pizza ohne Tomatensoße</strong></li>
        <li><strong>Eigenkreationen vom Pizzabäcker</strong></li>
        <li><strong>Italienisches Sandwich aus Pizzabrotteig</strong></li>
        <li><strong>Kindermenü</strong></li>
        <li><strong>Dessert</strong></li>
        <li><strong>Verschiedene Getränke</strong></li>
        <li><strong>Alkoholfreie Getränke</strong></li>
        <li><strong>Italienische Weine</strong></li>
        <li><strong>Biergetränke</strong></li>
      </ul>
    </section>
  </main>

  <footer>
    <div class="foot-links">
      <a href="/">Start</a>
      <a href="/speisekarte/">Speisekarte</a>
      <a href="/#hours">Öffnungszeiten</a>
      <a href="/#contact">Kontakt</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </div>
    <p class="foot-copy">© 2026 Bar Ristorante Pizzeria del Sud GmbH · Ritterstraße 3 · 35066 Frankenberg (Eder)<br/>Website erstellt von <a href="https://360-ai.org" target="_blank" rel="noopener noreferrer">360ai</a></p>
  </footer>

  <script>
    var hb=document.getElementById('ham-sub'),mb=document.getElementById('mob-sub');
    if(hb&&mb){hb.addEventListener('click',function(){var o=mb.classList.toggle('open');hb.setAttribute('aria-expanded',o);});}
    // Mobile: PDF-iframes werden auf Touch-Geräten oft nicht angezeigt
    var isMobile=/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)||(window.innerWidth<=768);
    if(isMobile){var iframe=document.getElementById('pdf-iframe'),fb=document.getElementById('pdf-mobile-fallback');if(iframe)iframe.style.display='none';if(fb)fb.style.display='block';}
  </script>
</body>
</html>
