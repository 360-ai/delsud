<button class="btt" id="btt" aria-label="Nach oben">
  <svg viewBox="0 0 24 24"><polyline points="6 15 12 9 18 15"/></svg>
</button>

<script>
  // getDay(): 0=So … 6=Sa — So mittags+abends, Mo/Di nur abends, Mi Ruhetag, Do–Sa mittags+abends
  const H={0:[{s:'11:30',e:'14:30'},{s:'17:30',e:'22:00'}],1:[{s:'17:30',e:'22:00'}],2:[{s:'17:30',e:'22:00'}],3:[],4:[{s:'11:30',e:'14:30'},{s:'17:30',e:'22:00'}],5:[{s:'11:30',e:'14:30'},{s:'17:30',e:'22:00'}],6:[{s:'11:30',e:'14:30'},{s:'17:30',e:'22:00'}]};
  const now=new Date(),day=now.getDay(),hm=now.getHours()*60+now.getMinutes(),slots=H[day]||[];
  const open=slots.some(sl=>{const[sh,sm]=sl.s.split(':').map(Number),[eh,em]=sl.e.split(':').map(Number);return hm>=sh*60+sm&&hm<=eh*60+em;});
  const dot=document.getElementById('dot'),st=document.getElementById('stext');
  const hDot=document.getElementById('hero-dot'),hSt=document.getElementById('hero-stext');
  let statusText='';
  if(!slots.length){dot.className='dot closed';hDot.className='hero-dot closed';statusText='Heute Ruhetag (Mittwoch)';}
  else if(open){statusText='Jetzt geöffnet';}
  else{dot.className='dot closed';hDot.className='hero-dot closed';const nx=slots.find(sl=>{const[sh,sm]=sl.s.split(':').map(Number);return sh*60+sm>hm;});statusText=nx?'Öffnet heute um '+nx.s+' Uhr':'Heute geschlossen';}
  st.textContent=statusText;hSt.textContent=statusText;

  const nav=document.getElementById('nav');
  window.addEventListener('scroll',()=>{nav.classList.toggle('scrolled',scrollY>60);document.getElementById('btt').classList.toggle('show',scrollY>400);},{passive:true});

  const ham=document.getElementById('ham'),mob=document.getElementById('mob');
  ham.addEventListener('click',()=>{ham.classList.toggle('open');mob.classList.toggle('open');ham.setAttribute('aria-expanded',mob.classList.contains('open'));});
  document.querySelectorAll('.ml').forEach(l=>l.addEventListener('click',()=>{ham.classList.remove('open');mob.classList.remove('open');}));

  document.getElementById('btt').addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));

  // Lightbox with prev/next
  const lb=document.getElementById('lightbox'),lbImg=document.getElementById('lb-img');
  const gpItems=[...document.querySelectorAll('.gp')];
  let lbIdx=0;
  const showLb=(i)=>{lbIdx=i;const img=gpItems[i].querySelector('img');lbImg.src=img.src;lbImg.alt=img.alt;lb.classList.add('open');document.body.style.overflow='hidden';};
  gpItems.forEach((g,i)=>g.addEventListener('click',()=>showLb(i)));
  const closeLb=()=>{lb.classList.remove('open');document.body.style.overflow='';};
  const prevLb=()=>{lbIdx=(lbIdx-1+gpItems.length)%gpItems.length;const img=gpItems[lbIdx].querySelector('img');lbImg.src=img.src;lbImg.alt=img.alt;};
  const nextLb=()=>{lbIdx=(lbIdx+1)%gpItems.length;const img=gpItems[lbIdx].querySelector('img');lbImg.src=img.src;lbImg.alt=img.alt;};
  document.getElementById('lb-prev').addEventListener('click',(e)=>{e.stopPropagation();prevLb();});
  document.getElementById('lb-next').addEventListener('click',(e)=>{e.stopPropagation();nextLb();});
  lb.addEventListener('click',(e)=>{if(e.target!==lbImg&&!e.target.closest('.lb-nav'))closeLb();});
  document.addEventListener('keydown',(e)=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')closeLb();if(e.key==='ArrowLeft')prevLb();if(e.key==='ArrowRight')nextLb();});

  const els=document.querySelectorAll('.reveal,.reveal-l,.reveal-r');
  els.forEach(el=>el.classList.add('h'));
  const io=new IntersectionObserver(ens=>{ens.forEach(e=>{if(e.isIntersecting){e.target.classList.remove('h');io.unobserve(e.target);}});},{threshold:0.01,rootMargin:'0px 0px 60px 0px'});
  els.forEach(el=>io.observe(el));
  setTimeout(()=>els.forEach(el=>el.classList.remove('h')),300);
</script>
</body>
</html>
