---
import { useStoryblokApi } from '@storyblok/astro';

// Fallback-Werte (Seite funktioniert auch ohne Storyblok-Verbindung)
let cms: any = {
  phone_display: '0170 3678734',
  phone_link: '01703678734',
  email: 'info@delsud-frankenberg.de',
  address_street: 'Ritterstraße 3',
  address_zip: '35066',
  address_city: 'Frankenberg (Eder)',
  hero_eyebrow: 'Bar · Ristorante · Pizzeria · Frankenberg (Eder)',
  hero_title: 'DEL SUD',
  hero_subtitle: 'Cucina autentica del sud Italia',
  hero_motto: 'Sentirsi bene e godere — Wohlfühlen und genießen',
  instagram_url: 'https://www.instagram.com/del_sud_italiano_/',
  about_text_1: 'Süditalien endet nicht am Mittelmeer. Im Del Sud bringen wir unsere Heimat nach Frankenberg — mit überlieferten Familienrezepten, handwerklicher Kochkunst und Zutaten, bei denen wir keine Kompromisse kennen. Denn unsere Leidenschaft gilt vor allem einem: Gästen, die sich bei uns wirklich wohlfühlen.',
  about_text_2: 'Ob Mittagstisch, romantisches Abendessen oder entspannter Abend an unserer Bar — bei uns findet jeder Anlass den richtigen Rahmen.',
};

const fallbackGalerie = [
  { bild: { filename: '/images/galerie-01.webp' }, beschriftung: 'Del Sud in der Ritterstraße' },
  { bild: { filename: '/images/galerie-02.webp' }, beschriftung: 'Herzlich willkommen – unser Eingang' },
  { bild: { filename: '/images/galerie-03.webp' }, beschriftung: 'Gemütliches Ambiente mit Vinothek' },
  { bild: { filename: '/images/galerie-04.webp' }, beschriftung: 'Unser Pizzaiolo bei der Arbeit' },
  { bild: { filename: '/images/galerie-05.webp' }, beschriftung: 'Einladender Gastraum' },
  { bild: { filename: '/images/galerie-06.webp' }, beschriftung: 'Pizza-Vielfalt aus dem Ofen' },
  { bild: { filename: '/images/galerie-07.webp' }, beschriftung: 'Tagliatelle mit frischen Tomaten' },
  { bild: { filename: '/images/galerie-08.webp' }, beschriftung: 'Frutti di Mare' },
  { bild: { filename: '/images/galerie-09.webp' }, beschriftung: 'Tiramisu della Casa' },
  { bild: { filename: '/images/galerie-10.webp' }, beschriftung: 'Pizza mit Burrata & Gamberi' },
  { bild: { filename: '/images/galerie-11.webp' }, beschriftung: 'Spaghetti Carbonara' },
  { bild: { filename: '/images/galerie-12.webp' }, beschriftung: 'Vino Rosso & herzhafte Beilagen' },
  { bild: { filename: '/images/galerie-13.webp' }, beschriftung: 'Spaghetti al Pomodoro' },
  { bild: { filename: '/images/galerie-14.webp' }, beschriftung: 'Fritto Misto di Mare' },
  { bild: { filename: '/images/galerie-15.webp' }, beschriftung: 'Pizza mit Salsiccia & Friarielli' },
  { bild: { filename: '/images/galerie-16.webp' }, beschriftung: 'Pasta al Limone' },
  { bild: { filename: '/images/galerie-17.webp' }, beschriftung: 'Antipasti-Variation' },
  { bild: { filename: '/images/galerie-18.webp' }, beschriftung: 'Spaghetti Bolognese' },
  { bild: { filename: '/images/galerie-19.webp' }, beschriftung: 'Insalata di Mare' },
  { bild: { filename: '/images/galerie-20.webp' }, beschriftung: 'Pizza & italienisches Flair' },
  { bild: { filename: '/images/galerie-21.webp' }, beschriftung: 'Fusilli mit Pesto & Rucola' },
  { bild: { filename: '/images/galerie-22.webp' }, beschriftung: 'Italienisches Bier – Ichnusa & Peroni' },
  { bild: { filename: '/images/galerie-23.webp' }, beschriftung: 'Pasta mit Gamberi' },
  { bild: { filename: '/images/galerie-24.webp' }, beschriftung: 'Dolce-Kreation des Hauses' },
  { bild: { filename: '/images/galerie-25.webp' }, beschriftung: 'Pasta mit hausgemachtem Pesto' },
  { bild: { filename: '/images/galerie-26.webp' }, beschriftung: 'Beste Zutaten aus Italien' },
  { bild: { filename: '/images/galerie-27.webp' }, beschriftung: 'Tagliatelle al Pesto' },
  { bild: { filename: '/images/galerie-28.webp' }, beschriftung: 'Cannelloni al Forno' },
  { bild: { filename: '/images/galerie-29.webp' }, beschriftung: 'Frische Pasta – jeden Tag' },
  { bild: { filename: '/images/galerie-30.webp' }, beschriftung: 'Herzhafte Bruschetta' },
];

try {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get('cdn/stories/home', {
    version: 'published',
  });
  cms = { ...cms, ...data.story.content };
} catch (e) {
  // Fallback aktiv – Storyblok nicht erreichbar oder Story noch nicht vorhanden
}

const galerie = (Array.isArray(cms.galerie) && cms.galerie.length > 0) ? cms.galerie : fallbackGalerie;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Del Sud – Italienisches Restaurant & Pizzeria in Frankenberg (Eder)</title>

  <!-- SEO Meta-Tags -->
  <meta name="description" content="Del Sud – Authentische italienische Küche in Frankenberg (Eder). Handgemachte Pizza, frische Pasta, erlesene Weine. Do–Di geöffnet. Jetzt reservieren!" />
  <meta name="keywords" content="Pizzeria Frankenberg, italienisches Restaurant, Pizza Frankenberg Eder, Del Sud, Ristorante, Bar, Reservierung, italienisch essen Frankenberg" />
  <meta name="author" content="Bar Ristorante Pizzeria del Sud GmbH" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://delsud-frankenberg.de/" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph / Social Media -->
  <meta property="og:title" content="Del Sud – Italienisches Restaurant & Pizzeria Frankenberg" />
  <meta property="og:description" content="Authentische italienische Küche in Frankenberg. Handgemachte Pizza, Pasta & mehr. Jetzt reservieren!" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://delsud-frankenberg.de/" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Del Sud Frankenberg" />
  <meta property="og:image" content="https://delsud-frankenberg.de/images/og-image.jpg?v=2" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Del Sud – Restaurant in Frankenberg (Eder)" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Del Sud – Pizzeria & Ristorante Frankenberg" />
  <meta name="twitter:description" content="Authentische italienische Küche in Frankenberg (Eder). Reservieren Sie jetzt!" />
  <meta name="twitter:image" content="https://delsud-frankenberg.de/images/og-image.jpg?v=2" />

  <!-- Geo Tags (Lokales SEO) -->
  <meta name="geo.region" content="DE-HE" />
  <meta name="geo.placename" content="Frankenberg (Eder)" />
  <meta name="geo.position" content="51.0589;8.7950" />
  <meta name="ICBM" content="51.0589, 8.7950" />

  <!-- Sicherheits-Header -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
  <style>
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/cormorant-garamond-600.ttf') format('truetype');}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/cormorant-garamond-700.ttf') format('truetype');}
    @font-face{font-family:'Mulish';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/mulish-400.ttf') format('truetype');}
    @font-face{font-family:'Mulish';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/mulish-700.ttf') format('truetype');}
    :root {
      --burg:        #3D1010;
      --burg-mid:    #5C1E1E;
      --gold:        #C9963A;
      --gold-lt:     #E8BF7A;
      --gold-dim:    rgba(201,150,58,0.14);
      --gold-border: rgba(201,150,58,0.30);
      --cream:       #FAF6EE;
      --cream-alt:   #F0E9D6;
      --text:        #1A0F0A;
      --muted:       #6B5040;
      --font-serif:  'Cormorant Garamond','Georgia',serif;
      --font-sans:   'Mulish','Trebuchet MS',sans-serif;
      --ease:        0.45s cubic-bezier(0.22,1,0.36,1);
      --nav-h:       68px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{font-family:var(--font-sans);background:var(--cream);color:var(--text);overflow-x:hidden;line-height:1.65;}
    img{display:block;max-width:100%;}
    a{color:inherit;text-decoration:none;}
    ul{list-style:none;}
    svg{display:block;}

    .container{max-width:1140px;margin:0 auto;padding:0 36px;}
    .eyebrow{font-size:0.7rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;}
    .sec-title{font-family:var(--font-serif);font-size:clamp(2.2rem,4.5vw,3.4rem);font-weight:600;line-height:1.1;color:var(--burg);margin-bottom:16px;}
    .sec-title em{color:var(--gold);font-style:italic;}
    .gold-line{width:54px;height:2px;background:var(--gold);margin-bottom:36px;}
    .gold-line.center{margin-left:auto;margin-right:auto;}

    .reveal,.reveal-l,.reveal-r{opacity:1;transform:none;transition:opacity 0.7s ease,transform 0.7s ease;}
    .reveal.h{opacity:0;transform:translateY(28px);}
    .reveal-l.h{opacity:0;transform:translateX(-32px);}
    .reveal-r.h{opacity:0;transform:translateX(32px);}

    .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;border-radius:50px;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;border:none;transition:var(--ease);}
    .btn-gold{background:var(--gold);color:#fff;}
    .btn-gold:hover{background:var(--burg);transform:translateY(-2px);box-shadow:0 10px 28px rgba(201,150,58,0.35);}
    .btn-ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,0.5);}
    .btn-ghost:hover{background:rgba(255,255,255,0.12);border-color:#fff;transform:translateY(-2px);}
    .btn-reserve{background:rgba(140,30,30,0.85);color:#fff;border:1.5px solid rgba(200,80,80,0.5);backdrop-filter:blur(6px);}
    .btn-reserve:hover{background:rgba(180,40,40,0.95);border-color:rgba(255,120,120,0.6);transform:translateY(-2px);box-shadow:0 10px 28px rgba(140,30,30,0.4);}
    .btn-reserve svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;}
    .btn-hours-reserve{background:rgba(140,30,30,0.85);color:#fff;border:1.5px solid rgba(200,80,80,0.5);}
    .btn-hours-reserve:hover{background:rgba(180,40,40,0.95);border-color:rgba(255,120,120,0.6);transform:translateY(-2px);box-shadow:0 10px 28px rgba(140,30,30,0.4);}
    .hero-status{display:inline-flex;align-items:center;gap:10px;background:rgba(0,0,0,0.35);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:50px;padding:10px 22px;margin-top:20px;cursor:pointer;text-decoration:none;transition:var(--ease);animation:fadeUp 1s 1.1s both;}
    .hero-status:hover{background:rgba(0,0,0,0.5);border-color:rgba(255,255,255,0.2);}
    .hero-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse2 2s infinite;flex-shrink:0;}
    .hero-dot.closed{background:#ef4444;animation:none;}
    .hero-status-text{font-size:0.74rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.8);}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:1000;height:var(--nav-h);transition:background var(--ease),box-shadow var(--ease);}
    nav.scrolled{background:rgba(61,16,16,0.96);backdrop-filter:blur(14px);box-shadow:0 2px 24px rgba(0,0,0,0.3);}
    .nav-inner{display:flex;align-items:center;justify-content:space-between;height:100%;}
    .nav-logo{display:flex;align-items:center;gap:10px;opacity:0;transition:opacity var(--ease);}
    nav.scrolled .nav-logo{opacity:1;}
    .nav-logo img{width:36px;height:36px;border-radius:50%;object-fit:cover;border:1.5px solid var(--gold);}
    .nav-logo-text{font-family:var(--font-serif);font-size:1.25rem;font-weight:700;color:#fff;letter-spacing:0.08em;}
    .nav-links{display:flex;align-items:center;gap:30px;}
    .nav-links a{font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.82);transition:color var(--ease);}
    .nav-links a:hover{color:var(--gold-lt);}
    .nav-cta{background:var(--gold);color:#fff;padding:9px 22px;border-radius:50px;font-size:0.76rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;transition:var(--ease);}
    .nav-cta:hover{background:#fff;color:var(--burg);}
    .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;}
    .hamburger span{display:block;width:24px;height:2px;background:var(--gold);border-radius:2px;transition:var(--ease);}
    .hamburger.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
    .hamburger.open span:nth-child(2){opacity:0;}
    .hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
    .mobile-menu{display:none;position:fixed;top:var(--nav-h);left:0;right:0;bottom:0;background:rgba(14,5,5,0.97);backdrop-filter:blur(18px);padding:32px 36px;flex-direction:column;gap:0;z-index:999;border-top:2px solid var(--gold);overflow-y:auto;}
    .mobile-menu.open{display:flex;}
    .mobile-menu a{font-size:0.88rem;font-weight:700;color:rgba(255,255,255,0.65);letter-spacing:0.12em;text-transform:uppercase;padding:16px 0;border-bottom:1px solid rgba(201,150,58,0.12);transition:color var(--ease),padding-left var(--ease);}
    .mobile-menu a:hover,.mobile-menu a:active{color:var(--gold-lt);padding-left:8px;}
    .mobile-menu a:last-child{border-bottom:none;margin-top:12px;color:var(--gold);border:1.5px solid var(--gold);border-radius:50px;text-align:center;padding:14px 0;}

    /* HERO */
    .hero{position:relative;height:100vh;min-height:680px;max-height:920px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:var(--burg);}
    .hero-bg{position:absolute;inset:0;overflow:hidden;pointer-events:none;}
    .hero-aurora{position:absolute;inset:-85%;filter:blur(72px);opacity:0.5;}
    .hero-aurora-1{
      background:repeating-linear-gradient(102deg,#2a0a0a 0%,#3D1010 8%,#5C1E1E 15%,#1a4d36 24%,#3d6b4f 28%,#C9963A 36%,#8B1e2e 44%,#5C1E1E 52%,#2a0a0a 60%);
      background-size:320% 100%;
      background-position:52% 50%;
      transform:translate(-1%,0.5%) scale(1.015);
    }
    .hero-aurora-2{
      inset:-40%;
      opacity:0.35;
      mix-blend-mode:soft-light;
      background:repeating-linear-gradient(-55deg,rgba(0,146,70,0.45) 0%,rgba(0,146,70,0.45) 6%,transparent 9%,transparent 11%,rgba(206,43,55,0.35) 18%,rgba(201,150,58,0.4) 26%,transparent 34%),
                  repeating-linear-gradient(100deg,#5C1E1E 10%,#C9963A 18%,#FAF6EE 25%,#8B1538 32%,#1a4d36 40%,#5C1E1E 48%);
      background-size:200% 100%,280% 100%;
      background-position:72% 50%,58% 50%;
      transform:rotate(2.5deg);
    }
    .hero-aurora-3{
      inset:-30%;
      opacity:0.28;
      filter:blur(50px);
      background:radial-gradient(ellipse 80% 60% at 30% 40%,rgba(232,191,122,0.5) 0%,transparent 55%),
                 radial-gradient(ellipse 70% 50% at 75% 60%,rgba(206,43,55,0.25) 0%,transparent 50%);
      transform:translate(2%,-1.5%) scale(1.04);
    }
    .hero-overlay{position:absolute;inset:0;background:radial-gradient(ellipse 90% 70% at 50% 35%,transparent 0%,rgba(15,4,4,0.5) 55%,rgba(8,2,2,0.92) 100%),linear-gradient(to bottom,rgba(15,4,4,0.38) 0%,rgba(25,6,6,0.65) 50%,rgba(8,2,2,0.94) 100%);}
    .hero-grain{position:absolute;inset:0;opacity:0.15;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-size:200px 200px;mix-blend-mode:overlay;}
    .hero-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 20px;}
    .hero-logo-wrap{margin-bottom:28px;animation:logoIn 1.2s cubic-bezier(0.22,1,0.36,1) both;}
    .hero-logo-ring{width:180px;height:180px;border-radius:50%;border:2px solid rgba(201,150,58,0.6);box-shadow:0 0 0 8px rgba(201,150,58,0.07),0 0 70px rgba(201,150,58,0.18),inset 0 0 40px rgba(0,0,0,0.4);overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);backdrop-filter:blur(6px);transition:box-shadow 0.5s ease,border-color 0.5s ease;cursor:pointer;}
    .hero-logo-ring:hover{border-color:var(--gold);box-shadow:0 0 0 8px rgba(201,150,58,0.15),0 0 40px rgba(201,150,58,0.4),0 0 80px rgba(201,150,58,0.2),inset 0 0 40px rgba(0,0,0,0.4);}
    .hero-logo-ring img{width:100%;height:100%;object-fit:cover;}
    @keyframes logoIn{from{opacity:0;transform:scale(0.75) translateY(20px);}to{opacity:1;transform:none;}}
    .hero-flag-bar{display:flex;width:32px;height:3px;border-radius:2px;margin:0 auto 14px;animation:fadeUp 1s 0.2s both;overflow:hidden;}
    .hero-flag-bar span:nth-child(1){flex:1;background:#009246;}
    .hero-flag-bar span:nth-child(2){flex:1;background:#fff;}
    .hero-flag-bar span:nth-child(3){flex:1;background:#CE2B37;}
    .hero-eyebrow{font-size:0.68rem;font-weight:700;letter-spacing:0.26em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;animation:fadeUp 1s 0.35s both;}
    .hero-title{font-family:var(--font-serif);font-size:clamp(3.6rem,7vw,7rem);font-weight:700;line-height:1.0;color:#fff;margin-bottom:8px;animation:fadeUp 1s 0.5s both;letter-spacing:0.06em;}
    .hero-sub{font-family:var(--font-serif);font-size:clamp(1rem,2vw,1.4rem);font-style:italic;color:var(--gold-lt);opacity:0.9;margin-bottom:12px;animation:fadeUp 1s 0.65s both;}
    .hero-sep{display:flex;align-items:center;gap:14px;justify-content:center;margin:16px auto 28px;animation:fadeUp 1s 0.75s both;}
    .hero-sep span{width:40px;height:1px;background:rgba(201,150,58,0.5);}
    .hero-sep em{font-family:var(--font-serif);font-size:0.85rem;font-style:italic;color:rgba(255,255,255,0.55);letter-spacing:0.08em;}
    .hero-btns{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;animation:fadeUp 1s 0.9s both;}
    .hero-btns .btn-ig{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border-radius:50px;background:linear-gradient(135deg,#833AB4 0%,#E1306C 45%,#F77737 100%);color:#fff;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;transition:var(--ease);border:none;cursor:pointer;box-shadow:0 8px 28px rgba(225,48,108,0.25);}
    .hero-btns .btn-ig:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(225,48,108,0.45);color:#fff;}
    .hero-btns .btn-ig:focus-visible{outline:2px solid #fff;outline-offset:3px;}
    .hero-btns .btn-ig svg{width:20px;height:20px;fill:currentColor;flex-shrink:0;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:none;}}
    .scroll-cue{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;opacity:0.45;animation:bounce 2s 1.5s infinite;}
    .scroll-cue span{font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:#fff;}
    @keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(7px);}}

    /* ABOUT */
    .about{padding:110px 0;background:var(--cream);}
    .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:start;}
    .about-imgs{position:relative;margin-top:45px;padding-bottom:60px;}
    .about-img-main{width:100%;height:auto;border-radius:16px;object-fit:cover;aspect-ratio:4/3;box-shadow:0 24px 70px rgba(0,0,0,0.14);display:block;}
    .about-img-float{position:absolute;bottom:0;right:24px;width:46%;height:auto;border-radius:12px;object-fit:cover;aspect-ratio:3/2;box-shadow:0 16px 48px rgba(0,0,0,0.18);border:5px solid var(--cream);display:block;}
    .about-tag{position:absolute;top:24px;left:24px;background:var(--gold);color:#fff;font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;padding:8px 16px;border-radius:4px;box-shadow:0 4px 16px rgba(201,150,58,0.4);}
    .about-text p{font-size:1rem;color:var(--muted);line-height:1.8;margin-bottom:16px;}
    .about-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:56px;}
    .fact{background:var(--cream-alt);border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:18px 18px;}
    .fact strong{display:block;font-family:var(--font-serif);font-size:1.6rem;color:var(--burg);line-height:1;margin-bottom:4px;}
    .fact span{font-size:0.72rem;color:var(--muted);letter-spacing:0.09em;text-transform:uppercase;}

    /* OFFER */
    .offer{padding:110px 0;background:var(--burg);}
    .offer .sec-title{color:#fff;}
    .offer .eyebrow{color:var(--gold-lt);}
    .offer .gold-line{background:var(--gold-lt);}
    .offer-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;margin-top:56px;border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.25);}
    .offer-card{background:rgba(255,255,255,0.04);padding:44px 32px;transition:var(--ease);border:1px solid rgba(255,255,255,0.06);position:relative;overflow:hidden;}
    .offer-card::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity var(--ease);pointer-events:none;}
    .offer-card:hover{background:rgba(255,255,255,0.07);}
    .offer-card:hover::before{opacity:1;}
    .offer-card:nth-child(1)::before{background:radial-gradient(circle at 0% 0%,rgba(0,146,70,0.18),transparent 60%),radial-gradient(circle at 100% 100%,rgba(0,146,70,0.12),transparent 60%);}
    .offer-card:nth-child(1):hover{border-color:rgba(0,146,70,0.25);}
    .offer-card:nth-child(2)::before{background:radial-gradient(circle at 0% 0%,rgba(255,255,255,0.12),transparent 60%),radial-gradient(circle at 100% 100%,rgba(255,255,255,0.08),transparent 60%);}
    .offer-card:nth-child(2):hover{border-color:rgba(255,255,255,0.2);}
    .offer-card:nth-child(3)::before{background:radial-gradient(circle at 0% 0%,rgba(206,43,55,0.18),transparent 60%),radial-gradient(circle at 100% 100%,rgba(206,43,55,0.12),transparent 60%);}
    .offer-card:nth-child(3):hover{border-color:rgba(206,43,55,0.25);}
    .offer-card:nth-child(4)::before{background:radial-gradient(circle at 0% 0%,rgba(201,150,58,0.18),transparent 60%),radial-gradient(circle at 100% 100%,rgba(201,150,58,0.12),transparent 60%);}
    .offer-card:nth-child(4):hover{border-color:rgba(201,150,58,0.25);}
    .offer-badge{display:inline-block;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold-border);border-radius:50px;padding:4px 14px;margin-bottom:16px;}
    .offer-ig-hint{display:flex;align-items:center;gap:6px;margin-top:14px;font-size:0.78rem;color:rgba(255,255,255,0.45);}
    .offer-ig-hint svg{width:14px;height:14px;fill:currentColor;flex-shrink:0;}
    .offer-img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;margin-bottom:22px;}
    .offer-card h3{font-family:var(--font-serif);font-size:1.7rem;color:#fff;margin-bottom:14px;}
    .offer-card p{font-size:0.9rem;color:rgba(255,255,255,0.6);line-height:1.7;}
    .offer-num{position:absolute;top:24px;right:24px;font-family:var(--font-serif);font-size:4rem;font-weight:700;color:rgba(201,150,58,0.07);line-height:1;pointer-events:none;}
    .speisekarte-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-top:32px;padding:28px 36px;background:rgba(255,255,255,0.04);border:1px solid var(--gold-border);border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,0.2);}
    .speisekarte-bar-text{display:flex;align-items:center;gap:16px;}
    .speisekarte-bar-text svg{width:28px;height:28px;stroke:var(--gold-lt);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
    .speisekarte-bar-text span{font-family:var(--font-serif);font-size:1.25rem;color:#fff;}
    .speisekarte-bar-text small{display:block;font-size:0.82rem;color:rgba(255,255,255,0.45);font-family:var(--font-sans);margin-top:3px;font-style:italic;}
    .btn-speisekarte{display:inline-flex;align-items:center;gap:10px;padding:13px 28px;border:1.5px solid var(--gold);background:var(--gold);color:var(--burg);font-size:0.88rem;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;border-radius:6px;transition:var(--ease);white-space:nowrap;font-weight:700;}
    .btn-speisekarte:hover{background:transparent;color:var(--gold-lt);}
    .btn-speisekarte svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;}

    /* FEATURE (Feiern & Events / Olivenöl) */
    .feature{padding:110px 0;}
    .feature.cream{background:var(--cream);}
    .feature.dark{background:var(--burg);}
    .feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;}
    .feature-media{position:relative;margin-top:45px;}
    .feature-media img{width:100%;height:auto;border-radius:16px;object-fit:cover;aspect-ratio:4/3;box-shadow:0 24px 70px rgba(0,0,0,0.16);}
    .feature-badge{position:absolute;top:18px;left:18px;background:var(--gold);color:#fff;font-size:0.68rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;padding:8px 16px;border-radius:4px;box-shadow:0 4px 16px rgba(201,150,58,0.4);}
    .feature.dark .feature-badge{left:auto;right:18px;}
    .feature.dark .sec-title{color:#fff;}
    .feature.dark .eyebrow{color:var(--gold-lt);}
    .feature.dark .gold-line{background:var(--gold-lt);}
    .feature-text p{font-size:1rem;color:var(--muted);line-height:1.8;margin-bottom:16px;}
    .feature.dark .feature-text p{color:rgba(255,255,255,0.72);}
    .feature-note{display:inline-flex;align-items:center;gap:10px;margin:8px 0 26px;padding:10px 18px;background:var(--gold-dim);border:1px solid var(--gold-border);border-radius:50px;font-size:0.82rem;font-weight:700;letter-spacing:0.03em;color:var(--gold);}
    .feature.dark .feature-note{color:var(--gold-lt);}
    .feature-note svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
    .btn-tel{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border-radius:50px;background:var(--gold);color:#fff;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;transition:var(--ease);border:none;cursor:pointer;}
    .btn-tel:hover{background:var(--burg);transform:translateY(-2px);box-shadow:0 10px 28px rgba(201,150,58,0.35);}
    .feature.dark .btn-tel:hover{background:#fff;color:var(--burg);}
    .btn-tel svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;}
    .feature-ph-hint{display:block;margin-top:12px;font-size:0.72rem;color:var(--muted);opacity:0.6;font-style:italic;}
    @media(max-width:960px){.feature-grid{grid-template-columns:1fr;gap:40px;}.feature-grid.reverse .feature-media{order:-1;}}

    /* REVIEWS */
    .reviews{padding:90px 0;background:var(--cream-alt);}
    .reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px;}
    .review-card{background:#fff;border:1px solid var(--gold-border);border-radius:14px;padding:32px 28px;box-shadow:0 6px 24px rgba(61,16,16,0.05);transition:var(--ease);position:relative;}
    .review-card:hover{transform:translateY(-4px);box-shadow:0 12px 36px rgba(61,16,16,0.1);}
    .review-stars{display:flex;gap:2px;margin-bottom:14px;}
    .review-stars svg{width:16px;height:16px;fill:var(--gold);}
    .review-text{font-size:0.92rem;color:var(--text);line-height:1.75;margin-bottom:18px;font-style:italic;}
    .review-author{font-size:0.8rem;font-weight:700;letter-spacing:0.06em;color:var(--muted);text-transform:uppercase;}
    .reviews-meta{text-align:center;margin-top:40px;}
    .reviews-badge{display:inline-flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--gold-border);border-radius:50px;padding:14px 28px;box-shadow:0 4px 16px rgba(0,0,0,0.06);}
    .reviews-badge-score{font-family:var(--font-serif);font-size:1.6rem;font-weight:700;color:var(--burg);}
    .reviews-badge-stars{display:flex;gap:2px;}
    .reviews-badge-stars svg{width:18px;height:18px;fill:var(--gold);}
    .reviews-badge-text{font-size:0.78rem;color:var(--muted);line-height:1.4;}
    .reviews-disclaimer{font-size:0.72rem;color:var(--muted);opacity:0.65;text-align:center;margin-top:20px;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.6;}
    @media(max-width:960px){.reviews-grid{grid-template-columns:1fr 1fr;}}
    @media(max-width:680px){.reviews-grid{grid-template-columns:1fr;}}

    /* HOURS */
    .hours{padding:110px 0;background:var(--cream-alt);}
    .hours-inner{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:start;}
    .hours-status{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--gold-border);border-radius:50px;padding:10px 20px;margin-bottom:32px;box-shadow:0 4px 16px rgba(0,0,0,0.06);}
    .dot{width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse2 2s infinite;}
    .dot.closed{background:#ef4444;animation:none;}
    @keyframes pulse2{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,0.4);}50%{box-shadow:0 0 0 6px rgba(34,197,94,0);}}
    .status-text{font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text);}
    .hours-table{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,0.07);}
    .h-row{display:flex;justify-content:space-between;align-items:center;padding:16px 24px;border-bottom:1px solid rgba(0,0,0,0.05);}
    .h-row:last-child{border-bottom:none;}
    .h-row.ruhetag{background:rgba(0,0,0,0.02);}
    .h-day{font-size:0.82rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text);}
    .h-time{font-family:var(--font-serif);font-size:1.1rem;font-weight:700;color:var(--gold);text-align:right;}
    .h-time.off{color:#bbb;font-style:italic;font-weight:400;}

    /* GALLERY */
    .gallery{padding:110px 0;background:var(--cream);}
    .gallery-mosaic{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:60px;border-radius:16px;overflow:hidden;}
    .gp{overflow:hidden;position:relative;cursor:pointer;aspect-ratio:1;}
    .gp img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;}
    .gp:hover img{transform:scale(1.06);}
    .lightbox{display:none;position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,0.92);backdrop-filter:blur(8px);align-items:center;justify-content:center;cursor:pointer;padding:24px;}
    .lightbox.open{display:flex;}
    .lightbox img{max-width:90vw;max-height:85vh;object-fit:contain;border-radius:10px;box-shadow:0 20px 80px rgba(0,0,0,0.6);animation:lbIn 0.25s ease;}
    .lightbox-close{position:absolute;top:20px;right:24px;width:40px;height:40px;border:none;background:rgba(255,255,255,0.1);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.3s;}
    .lightbox-close:hover{background:rgba(255,255,255,0.25);}
    .lightbox-close svg{width:20px;height:20px;stroke:#fff;stroke-width:2.5;}
    .lb-nav{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border:none;background:rgba(255,255,255,0.1);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.3s;z-index:2001;}
    .lb-nav:hover{background:rgba(255,255,255,0.25);}
    .lb-nav svg{width:24px;height:24px;stroke:#fff;stroke-width:2.5;fill:none;}
    .lb-prev{left:20px;}
    .lb-next{right:20px;}
    @keyframes lbIn{from{opacity:0;transform:scale(0.92);}to{opacity:1;transform:scale(1);}}
    .gallery-ig{margin-top:44px;padding:28px 32px;background:var(--cream-alt);border:1px solid var(--gold-border);border-radius:16px;text-align:center;box-shadow:0 6px 28px rgba(61,16,16,0.06);}
    .gallery-ig p{font-size:0.98rem;color:var(--muted);margin-bottom:16px;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.65;}
    .gallery-ig .btn-ig{display:inline-flex;align-items:center;gap:10px;padding:13px 28px;border-radius:50px;background:linear-gradient(135deg,#833AB4 0%,#E1306C 45%,#F77737 100%);color:#fff;font-weight:700;font-size:0.85rem;letter-spacing:0.04em;text-decoration:none;transition:var(--ease);border:none;}
    .gallery-ig .btn-ig:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(225,48,108,0.35);color:#fff;}
    .gallery-ig .btn-ig svg{width:20px;height:20px;fill:currentColor;flex-shrink:0;}

    /* FAQ Accordion */
    .faq{padding:90px 0;background:var(--cream-alt);}
    .faq-list{max-width:740px;margin:0 auto;}
    .faq-item{border-bottom:1px solid var(--gold-border);}
    .faq-item:last-child{border-bottom:none;}
    .faq-q{font-family:var(--font-serif);font-size:1.15rem;font-weight:700;color:var(--burg);cursor:pointer;padding:22px 36px 22px 0;position:relative;list-style:none;display:block;}
    .faq-q::-webkit-details-marker{display:none;}
    .faq-q::after{content:'';position:absolute;right:4px;top:50%;width:10px;height:10px;border-right:2px solid var(--gold);border-bottom:2px solid var(--gold);transform:translateY(-60%) rotate(45deg);transition:transform 0.3s ease;}
    .faq-item[open] .faq-q::after{transform:translateY(-30%) rotate(-135deg);}
    .faq-q:hover{color:var(--gold);}
    .faq-a{font-size:0.92rem;color:var(--muted);line-height:1.7;padding:0 0 22px;}

    /* CONTACT */
    .contact{padding:110px 0;background:var(--burg);}
    .contact .sec-title{color:#fff;}
    .contact .eyebrow{color:var(--gold-lt);}
    .contact-wrap{display:grid;grid-template-columns:1fr 1.4fr;gap:80px;margin-top:60px;align-items:center;}
    .contact-cta{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;}
    .c-info-block{display:flex;gap:16px;margin-bottom:28px;align-items:flex-start;}
    .c-icon{width:44px;height:44px;border-radius:50%;background:rgba(201,150,58,0.12);border:1px solid var(--gold-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .c-icon svg{width:18px;height:18px;stroke:var(--gold-lt);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
    .c-label{font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:4px;}
    .c-value{font-size:0.95rem;color:rgba(255,255,255,0.8);line-height:1.6;}
    .c-value a{color:var(--gold-lt);}
    .map-ph{background:rgba(255,255,255,0.04);border:1px solid var(--gold-border);border-radius:12px;padding:36px 20px;text-align:center;color:rgba(255,255,255,0.35);font-size:0.82rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;margin-top:4px;}
    .map-ph svg{width:28px;height:28px;stroke:rgba(201,150,58,0.45);fill:none;stroke-width:1.5;stroke-linecap:round;}
    .map-ph a{color:var(--gold-lt);text-decoration:underline;font-size:0.8rem;}

    /* FOOTER */
    footer{background:#0E0505;padding:40px 0 28px;}
    .foot-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;}
    .foot-logo{display:flex;align-items:center;gap:12px;}
    .foot-logo img{width:40px;height:40px;border-radius:50%;border:1.5px solid rgba(201,150,58,0.4);}
    .foot-logo span{font-family:var(--font-serif);font-size:1.3rem;color:#fff;letter-spacing:0.08em;}
    .foot-links{display:flex;gap:22px;flex-wrap:wrap;}
    .foot-links a{font-size:0.75rem;color:rgba(255,255,255,0.38);transition:color var(--ease);letter-spacing:0.06em;}
    .foot-links a:hover{color:var(--gold-lt);}
    .foot-copy{font-size:0.72rem;color:rgba(255,255,255,0.22);text-align:center;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.06);}
    .foot-copy a{color:var(--gold);opacity:0.7;}

    /* BACK TO TOP */
    .btt{position:fixed;bottom:28px;right:28px;width:46px;height:46px;background:var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 6px 20px rgba(201,150,58,0.4);opacity:0;pointer-events:none;transition:var(--ease);z-index:999;border:none;}
    .btt.show{opacity:1;pointer-events:all;}
    .btt:hover{background:var(--burg);transform:translateY(-3px);}
    .btt svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.5;stroke-linecap:round;}

    @media(min-width:960px){
      .hero-aurora-1,.hero-aurora-2{filter:blur(88px);}
    }
    @media(prefers-reduced-motion:reduce){
      *{animation-duration:0.01ms !important;transition-duration:0.01ms !important;}
      .gp:hover img{transform:none;}
    }
    @media(max-width:960px){
      .about-grid,.hours-inner,.contact-wrap{grid-template-columns:1fr;gap:48px;}
      .about-imgs,.feature-media{margin-top:0;}
      .offer-cards{grid-template-columns:1fr 1fr;}
      .speisekarte-bar{flex-direction:column;align-items:flex-start;}
      .gallery-mosaic{grid-template-columns:repeat(3,1fr);}
      .foot-inner{flex-direction:column;text-align:center;}
    }
    @media(max-width:680px){
      :root{--nav-h:60px;}
      .container{padding:0 20px;}
      .nav-links,.nav-cta{display:none;}
      .hamburger{display:flex;}
      .hero-logo-ring{width:130px;height:130px;}
      .hero-title{font-size:3rem;}
      .hero-btns{flex-direction:column;align-items:center;}
      .scroll-cue{display:none;}
      .about-img-main{width:100%;}
      .about-img-float{width:52%;right:12px;}
      .about-facts{grid-template-columns:repeat(2,1fr);margin-top:40px;}
      .gallery-mosaic{grid-template-columns:repeat(2,1fr);}
      .offer-cards{grid-template-columns:1fr;}
      .offer-img{aspect-ratio:2/1;}
    }
    @media(max-height:780px){
      .scroll-cue{display:none;}
    }
    /* Skip-Link */
    .skip-link{position:absolute;top:-999px;left:-999px;z-index:10000;padding:10px 18px;background:var(--gold);color:var(--burg);font-weight:700;text-decoration:none;border-radius:4px;font-size:0.9rem;}
    .skip-link:focus{top:12px;left:12px;}
