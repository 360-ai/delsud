    :root{--burg:#3D1010;--gold:#C9963A;--gold-lt:#E8BF7A;--gold-border:rgba(201,150,58,0.30);--cream:#FAF6EE;--text:#1A0F0A;--muted:#6B5040;--font-serif:'Cormorant Garamond',Georgia,serif;--font-sans:'Mulish','Trebuchet MS',sans-serif;--ease:0.35s ease;}
