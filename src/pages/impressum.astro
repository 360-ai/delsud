    .foot-links{display:flex;gap:18px;flex-wrap:wrap;justify-content:center;margin-bottom:14px;}
    .foot-links a{font-size:0.75rem;color:rgba(255,255,255,0.38);text-decoration:none;}
    .foot-links a:hover{color:var(--gold-lt);}
    @media(max-width:680px){.topbar-inner{padding:0 20px;}.topbar-nav{display:none;}.hamburger-sub{display:flex;}}
